# Public site URL (canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — leave empty to run on the clearly-fake DEMO fixtures.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: private evidence uploads. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: force the data source ("supabase" | "fixtures").
# Fixtures are always refused on a Vercel *production* deployment.
DATA_SOURCE=

# Optional: unlock the in-memory demo admin on a deployed preview (fixture mode only).
# In local development the demo admin is open without a password.
ADMIN_DEMO_PASSWORD=
